/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for the SEQC2 DNA-only benchmark run
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Derived from examples/seq2neo/seq2neo.shared.config ("copy and edit"):
    DNA-only (rna=false), WES, tumor-normal pair, variant callers + consensus only
    (no vep/filtering; rescue/rna_filtering/realignment are RNA-only).

    Input and outdir are NOT set here — pass them per run:
        nextflow run main.nf -c examples/seqc2/seqc2.shared.config \
            --input <samplesheet.csv> --outdir <OUTDIR> -offline -with-conda -resume

    BAM input (default here): samplesheet with patient,status,sample,lane,bam,bai
    and step = "variant_calling". FASTQ input: fastq_1/fastq_2 columns and
    override with --step mapping.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 104,
        memory: '220.GB',
        time: '36.h'
    ]
}

params {
    config_profile_name        = 'Seqc2'
    config_profile_description = 'SEQC2 DNA-only benchmark running config'
    custom_config_base         = "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/pipeline/configs/"

    // Input data
    save_bam_mapped                 = true
    save_output_as_bam              = false
    rna                             = false
    dna                             = true
    wes                             = true
    seq_platform                    = 'ILLUMINA'

    // Reference genome (GRCh38, GATK bundle)
    step                 = "variant_calling"   // BAM input; use --step mapping for FASTQ
    genome               = 'GRCh38'
    fasta                = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta'
    fasta_fai            = "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta.fai"
    bwa                  = "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Sequence/BWAIndex"
    aligner              = "bwa-mem"
    igenomes_base        = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references'
    igenomes_ignore      = false
    download_cache       = false
    dbsnp                = "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/dbsnp_146.hg38.vcf.gz"
    dbsnp_tbi            = "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/dbsnp_146.hg38.vcf.gz.tbi"
    pon                  = "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/1000g_pon.hg38.vcf.gz"
    pon_tbi              = "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/1000g_pon.hg38.vcf.gz.tbi"
    germline_resource    = "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/af-only-gnomad.hg38.vcf.gz"
    germline_resource_tbi= "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/af-only-gnomad.hg38.vcf.gz.tbi"
    no_intervals         = false
    intervals            = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/data/giab/data/seqc2/metadata/ComprehensiveCancer.dna_manifest.20220908.bed'

    // gnomAD & COSMIC annotation (feeds consensus classification)
    cosmic_database                           = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/COSMIC/ucsc_chr_cosmic_GenomeScreensMutant_Normal_v103_GRCh38.vcf.gz'
    gnomad_database                           = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/gnomAD/exomes'
    enable_cosmic_gnomad_annotation           = true
    cosmic_gnomad_verbose                     = false
    cosmic_gnomad_germline_freq_threshold     = 0.001
    cosmic_gnomad_somatic_consensus_threshold = 2
    cosmic_gnomad_cosmic_recurrence_threshold = 5

    // params
    trim_fastq                                = false
    split_fastq                               = 0           // no FASTQ splitting
    save_trimmed                              = false
    defaultvariantcallers                     = "deepsomatic,strelka,mutect2"
    tools                                     = 'deepsomatic,mutect2,strelka,norm,consensus'
    vc_priority                               = 'deepsomatic mutect2 strelka consensus'
}
