// HG008 WGS resume profile: retain the original metadata/output IDs,
// but pass the caller-ready BAM header sample name to Mutect2.
includeConfig "seqc2.hybrid.hg008.wgs.config"

params {
    hg008_mutect2_normal_sample = 'HG008-N'
}

process {
    withName: '.*:MUTECT2_PAIRED' {
        ext.args = {
            def soft_clip = params.ignore_soft_clipped_bases ? '--dont-use-soft-clipped-bases true ' : ''
            "${soft_clip}--f1r2-tar-gz ${task.ext.prefix}.f1r2.tar.gz --smith-waterman FASTEST_AVAILABLE --normal-sample ${params.hg008_mutect2_normal_sample} "
        }
    }
}
