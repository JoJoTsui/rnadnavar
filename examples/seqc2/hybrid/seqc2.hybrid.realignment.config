includeConfig "/tmp/rnadnavar-seqc2-review/examples/seqc2/seqc2.hybrid.shared.config"

params {
    config_profile_name = 'Seqc2HybridRealignment'
    config_profile_description = 'SEQC2 WES_LL caller-ready DNA plus pooled RNA FASTQ, VCF realignment enabled'
    step = 'mapping'

    // Hybrid runs must enable both modalities; the shared seqc2 config is DNA-only.
    rna = true
    dna = true

    // Selecting the tool is the workflow gate. Keep this confined to hybrid runs.
    tools = 'deepsomatic,mutect2,strelka,norm,consensus,rescue,filtering,rna_filtering,realignment'
    realignment_mode = 'vcf'
    enable_vcf_realignment_optimization = true
    enable_rna_annotation = true
    enable_cosmic_gnomad_annotation = true
    hisat2_index = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/hisat2/*.ht2'
    splicesites = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/hisat2/genes.splice_sites.txt'
    save_bam_mapped = false
    save_output_as_bam = false
}
