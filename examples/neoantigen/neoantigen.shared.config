/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the neoantigen preparation workflow
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Enables the opt-in neoantigen branch: FORMAT harmonization, Salmon quantification,
    and neoantigen-ready VCF selection/publishing.

    Use as follows:
        nextflow run rnadnavar/main.nf \
            -c rnadnavar/examples/neoantigen/neoantigen.shared.config \
            --input <samplesheet.csv> \
            --outdir <OUTDIR>

    REQUIRED before first use:
        Set salmon_index to the absolute path of your pre-built Salmon v1.11.x index.
        See scripts/build_salmon_index.sh to build one from Gencode v49.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Neoantigen'
    config_profile_description = 'Neoantigen preparation workflow config'

    // ── Neoantigen workflow options ───────────────────────────────────────────
    enable_neoantigen_workflow  = true
    neoantigen_input_source     = 'consensus'

    // REQUIRED: set this to the absolute path of your Salmon v1.11.x index.
    // Build one with: bash scripts/build_salmon_index.sh
    // Indices built with Salmon v1.10.x or earlier are NOT compatible and must
    // be rebuilt with v1.11.x before use.
    salmon_index                = '/path/to/salmon_index_gencode_v49'

    salmon_libtype              = 'A'
    salmon_gc_bias              = false
}
