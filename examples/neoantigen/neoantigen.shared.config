/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the neoantigen preparation workflow
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Full pipeline config: reference genome + tools + neoantigen branch.
    All reference paths point to the shared bio_db on this cluster, accessible
    to all teammates.

    Shared infrastructure layout:
        Pipeline repo : /t9k/mnt/WorkSpace/data/ngs/xuzhenyu/pipeline/rnadnavar/
        Reference DBs : /t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/
        Test dataset  : /t9k/mnt/WorkSpace/data/ngs/xuzhenyu/work/rnadnavar_test/
        Conda envs    : /t9k/mnt/joey/nf_conda_envs/

    Usage (via convenience wrapper — recommended):
        bash examples/neoantigen/run.sh

    Usage (direct nextflow invocation):
        nextflow run /t9k/mnt/WorkSpace/data/ngs/xuzhenyu/pipeline/rnadnavar/main.nf \
            -c /t9k/mnt/WorkSpace/data/ngs/xuzhenyu/pipeline/rnadnavar/examples/neoantigen/neoantigen.shared.config \
            --input  <samplesheet.csv> \
            --outdir <OUTDIR>

    Params you need to set before first use:
        salmon_index — absolute path to a pre-built Salmon v1.11.x index.
                       A shared index is already available at:
                       /t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/salmon/salmon_index_gencode_v49_salmon_v1.11
                       Build your own with: bash scripts/build_salmon_index.sh

    Params you may want to change per run:
        neoantigen_input_source — 'mutect2' (default, recommended for pVACseq/seq2neo)
                                   or 'consensus' (multi-caller union, INFO-field only)
        tools                  — remove tools you don't need to speed up the run
        resourceLimits         — adjust cpus/memory/time for your compute node
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 24,
        memory: '120.GB',
        time: '4.h'
    ]
}

params {
    config_profile_name        = 'Neoantigen'
    config_profile_description = 'Neoantigen preparation workflow config'
    custom_config_base         = "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/pipeline/configs/"

    // ── Input / output ────────────────────────────────────────────────────────
    // Set via --input / --outdir CLI flags or run.sh; do not hardcode here.
    // input  = "/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/work/rnadnavar_test/C008801/input/test.rdv.shared.csv"
    // outdir = "output/COO8801.neoantigen"

    // ── Sample / sequencing options ───────────────────────────────────────────
    save_bam_mapped                 = true
    save_output_as_bam              = false
    rna                             = true
    dna                             = true
    wes                             = true
    seq_platform                    = 'ILLUMINA'

    // ── Reference genome (shared bio_db) ──────────────────────────────────────
    step                 = "mapping"
    genome               = 'GRCh38'
    fasta                = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta'
    fasta_fai            = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta.fai'
    star_index           = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/star'
    hisat2_index         = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/hisat2'
    bwa                  = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Sequence/BWAIndex'
    aligner              = 'bwa-mem'
    igenomes_base        = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references'
    igenomes_ignore      = false
    download_cache       = false
    dbsnp                = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/dbsnp_146.hg38.vcf.gz'
    dbsnp_tbi            = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/dbsnp_146.hg38.vcf.gz.tbi'
    pon                  = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/1000g_pon.hg38.vcf.gz'
    pon_tbi              = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/1000g_pon.hg38.vcf.gz.tbi'
    germline_resource    = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/af-only-gnomad.hg38.vcf.gz'
    germline_resource_tbi= '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/af-only-gnomad.hg38.vcf.gz.tbi'
    no_intervals         = false
    intervals            = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/intervals/ukb.pad50.broad.pad50.union.bed'
    gtf                  = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/references/Homo_sapiens/NCBI/GRCh38/Annotation/Genes.gencode/genes.gtf'
    vep_cache            = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/vep'
    vep_cache_version    = 115
    vep_species          = 'homo_sapiens'
    vep_genome           = 'GRCh38'
    vep_include_fasta    = true

    // ── RNA editing (shared bio_db) ───────────────────────────────────────────
    enable_rna_annotation = true
    rediportal_vcf        = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/rna_editing/REDIportal/REDIportal_hg38_v3.vcf.gz'
    rediportal_tbi        = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/rna_editing/REDIportal/REDIportal_hg38_v3.vcf.gz.tbi'
    min_rna_support       = 2

    // ── COSMIC / gnomAD annotation (shared bio_db) ────────────────────────────
    cosmic_database                           = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/COSMIC/ucsc_chr_cosmic_GenomeScreensMutant_Normal_v103_GRCh38.vcf.gz'
    gnomad_database                           = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/gnomAD/exomes'
    enable_cosmic_gnomad_annotation           = true
    cosmic_gnomad_verbose                     = false
    cosmic_gnomad_germline_freq_threshold     = 0.001
    cosmic_gnomad_somatic_consensus_threshold = 2
    cosmic_gnomad_cosmic_recurrence_threshold = 5

    // ── Pipeline tools ────────────────────────────────────────────────────────
    trim_fastq             = true
    split_fastq            = 0
    save_trimmed           = true
    defaultvariantcallers  = 'deepsomatic,strelka,mutect2'
    tools                  = 'deepsomatic,mutect2,strelka,vep,norm,consensus,rescue,filtering,rna_filtering,realignment'
    vc_priority            = 'deepsomatic mutect2 strelka consensus'
    realignment_mode       = 'vcf'

    // ── Neoantigen workflow options ───────────────────────────────────────────
    enable_neoantigen_workflow = true

    // 'mutect2' (default): Mutect2-filtered VCF — has per-sample FORMAT (GT/AD/AF/DP/GQ),
    //   ~91 filtered somatic variants, directly compatible with pVACseq and seq2neo.
    // 'consensus': multi-caller union VCF — FORMAT column is empty (.); all evidence
    //   is in INFO fields (VAF_BY_CALLER, AD_BY_CALLER, etc.). Use only if your
    //   downstream tool can consume INFO-field-based format.
    neoantigen_input_source = 'mutect2'

    // Salmon v1.11.x index (shared bio_db — pre-built, ready to use):
    //   /t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/salmon/salmon_index_gencode_v49_salmon_v1.11
    // To build your own: bash scripts/build_salmon_index.sh --outdir <dir>
    // NOTE: indices from Salmon v1.10.x or earlier are NOT compatible with v1.11.x.
    salmon_index   = '/t9k/mnt/WorkSpace/data/ngs/xuzhenyu/bio_db/salmon/salmon_index_gencode_v49_salmon_v1.11'

    salmon_libtype = 'A'    // 'A' = automatic library type detection (recommended)
    salmon_gc_bias = false  // set true to enable GC bias correction (adds ~2 min/sample)
}
