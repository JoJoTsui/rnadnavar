/*
 * Bounded regression overlay for the production seq2neo topology.
 *
 * The real project config remains the base. Only site-sized resources and
 * fixtures are replaced here, so changes to seq2neo's enabled workflow stages
 * are exercised instead of being copied into a disconnected test profile.
 */
includeConfig '../../examples/seq2neo/seq2neo.shared.config'

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'Seq2neo bounded regression'
    config_profile_description = 'DN/DT/RT regression inheriting seq2neo.shared.config'
    custom_config_base         = '/t9k/mnt/hdd/work/Vax/pipeline/configs'

    input  = "${projectDir}/tests/csv/3.0/fastq_triplet_local.csv"
    step   = 'mapping'
    dna    = true
    rna    = true
    wes    = true

    genome          = null
    igenomes_ignore = true
    fasta           = '/t9k/mnt/hdd/work/Vax/rnadnavar/test-datasets/reference/chr7_hg38/GRCh38.d1.vd1.chr7.mini.fa'
    fasta_fai       = null
    dict            = null
    bwa             = null
    star_index      = null
    hisat2_index    = null
    gtf             = '/t9k/mnt/hdd/work/Vax/rnadnavar/test-datasets/reference/chr7_hg38/gencode.v36.annotation.chr7.mini.gtf'

    dbsnp             = '/t9k/mnt/hdd/work/Vax/rnadnavar/test-datasets/reference/chr7_hg38/dbsnp_146.hg38.chr7.mini.vcf.gz'
    dbsnp_tbi         = null
    germline_resource = "${projectDir}/.artifacts/seq2neo-regression/fixtures/af-only-gnomad.hg38.chr7.ref-consistent.vcf.gz"
    germline_resource_tbi = "${projectDir}/.artifacts/seq2neo-regression/fixtures/af-only-gnomad.hg38.chr7.ref-consistent.vcf.gz.tbi"
    pon                = null
    pon_tbi            = null
    no_intervals       = false
    intervals          = "${projectDir}/tests/data/seq2neo_chr7_smoke.bed"

    vep_cache         = '/t9k/mnt/hdd/work/Vax/rnadnavar/test-datasets/resources/vep'
    vep_cache_version = 999
    vep_species       = 'homo_sapiens'
    vep_genome        = 'GRCh38'
    vep_custom_args   = '--use_given_ref --no_progress --offline --shift_hgvs 1 --check_existing --tsl --domains --total_length --allele_number --no_escape --xref_refseq --failed 1 --flag_pick_allele --pick_order canonical,tsl,biotype,rank,ccds,length --format vcf --biotype --force_overwrite --sift p --polyphen p --variant_class --regulatory --allele_number --af_gnomad --af_gnomadg --gene_phenotype --hgvs --hgvsg --max_af'

    rediportal_vcf        = "${projectDir}/tests/data/test_rediportal.vcf.gz"
    rediportal_tbi        = "${projectDir}/tests/data/test_rediportal.vcf.gz.tbi"
    cosmic_database       = "${projectDir}/tests/data/test_cosmic.vcf.gz"
    gnomad_database       = "${projectDir}/tests/data/gnomad"
    enable_rna_annotation = true
    enable_cosmic_gnomad_annotation = true

    trim_fastq       = true
    split_fastq      = 0
    save_trimmed     = false
    save_bam_mapped  = false
    save_output_as_bam = false

    consensus_expected_callers = 'deepsomatic,mutect2,strelka'
    tools = 'deepsomatic,mutect2,strelka,vep,norm,consensus,rescue,filtering,rna_filtering,realignment'
}
