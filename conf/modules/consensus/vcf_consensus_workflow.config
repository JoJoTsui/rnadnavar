/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for VCF Consensus Workflow module
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: 'VCF_CONSENSUS' {
        ext.prefix = { "${meta.id}" }
        ext.thr = 2
        // Validated native-evidence SNV policy is default-on; explicit false opts out.
        ext.native_evidence_snv = params.native_evidence_snv != null ? params.native_evidence_snv : true
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/consensus/${meta.id}/" },
            pattern: "*{vcf,vcf.gz,vcf.gz.tbi}"
        ]
    }

    withName: 'VCF_CONSENSUS_RESCUE' {
        ext.prefix = { "${meta.id}" }
        ext.thr = 2
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/rescue/${meta.id}/" },
            pattern: "*{vcf,vcf.gz,vcf.gz.tbi}"
        ]
    }

    withName: 'VCF_RESCUE' {
        ext.prefix = { "${meta.id}" }
        ext.snv_thr = 2
        ext.indel_thr = 2
        ext.rescue_min_dna_callers = params.rescue_min_dna_callers != null ? params.rescue_min_dna_callers : 1
        ext.rescue_min_rna_callers = params.rescue_min_rna_callers != null ? params.rescue_min_rna_callers : 2
        ext.rescue_veto = params.rescue_veto ?: 'dna'
        ext.disable_rescue_promotion = params.rescue_promotion_enabled == false
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/rescue/${meta.id}/" },
            pattern: "*{vcf,vcf.gz,vcf.gz.tbi}"
        ]
    }

    withName: 'VCF_RESCUE_FILTER' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/filtered/${meta.id}/" },
            pattern: "*{vcf,vcf.gz,vcf.gz.tbi}"
        ]
    }
}
