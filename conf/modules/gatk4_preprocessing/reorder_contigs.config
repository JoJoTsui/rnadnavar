/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for BAM contig reordering
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Handles BAM files with contigs not present in the reference (e.g., viral sequences)
----------------------------------------------------------------------------------------
*/

process {
    withLabel: 'process_alignment_dictionary' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/preprocessing/alignment_dictionary/${meta.id}/" },
            pattern: "*.dictionary_audit.json"
        ]
    }

    withName: 'PICARD_REORDERSAM' {
        ext.args = ''
        publishDir = [
            enabled: params.save_normalized_bam,
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/preprocessing/alignment_dictionary/${meta.id}/" },
            pattern: "*.{bam,bam.bai}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
